{
    "name": "hnooz/filament-zone-map",
    "description": "Draw, edit and display geographic zones on Google Maps in Filament.",
    "keywords": ["laravel", "filament", "filament-plugin", "google-maps", "geojson", "zones", "polygon"],
    "homepage": "https://github.com/hnooz/filament-zone-map",
    "support": {
        "issues": "https://github.com/hnooz/filament-zone-map/issues",
        "source": "https://github.com/hnooz/filament-zone-map"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Mohamed Idris",
            "homepage": "https://moidris.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0||^13.0",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "larastan/larastan": "^3.15",
        "laravel/pint": "^1.25",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.0||^5.0",
        "pestphp/pest-plugin-arch": "^4.0||^5.0",
        "pestphp/pest-plugin-laravel": "^4.0||^5.0",
        "pestphp/pest-plugin-livewire": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Hnooz\\FilamentZoneMap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hnooz\\FilamentZoneMap\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hnooz\\FilamentZoneMap\\FilamentZoneMapServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
